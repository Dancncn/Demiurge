# 依赖与构建产物
node_modules/
dist/
src-tauri/target/
src-tauri/gen/
.tauri-dev/

# 本地调试与 Playwright MCP 产物
.playwright-mcp/
.tmp/
demiurge-*.png
playwright-report/
test-results/

# 本地编译加速：把 target 指向另一个项目以复用已编译依赖（含绝对路径，仅本机有效，不入库）
src-tauri/.cargo/

# 本地角色包（不把具体角色素材提交进仓库）；保留通用 default 作为格式参考
packs/*
!packs/default/

# Cubism Core（Live2D 私有运行时，用户自行下载，不入库）
public/core/live2dcubismcore.min.js

# 本地配置
.env
.env.local

# 本地 GPT-SoVITS 启动脚本与音色配置（含本机绝对路径与个人训练模型引用，仅本机有效，不入库）
scripts/gpt-sovits-dan-tts.yaml
scripts/start-gpt-sovits-dan.ps1

# 编辑器
.vscode/
.idea/
.DS_Store
/.agent-worktrees
/.demiurge/compat

# GOAI 本地提交附件：比赛只提交代码仓库链接，不把演示稿、PDF、压缩包或检查输出混入 Git
competition/*.pptx
competition/*.pdf
competition/*.zip
competition/*.inspect.ndjson
competition/agentteams/demo/__pycache__/
competition/agentteams/demo/evidence/generate_visuals.py

# 只保留一份可复核的 canonical 运行结果；其他历史运行目录和根目录重复输出为本地产物
competition/agentteams/demo/outputs/*
!competition/agentteams/demo/outputs/ui-fridge-ecu-screening/
!competition/agentteams/demo/outputs/ui-fridge-ecu-screening/**
