/begin PROJECT SIM_FRIDGE_ECU "Synthetic vehicle refrigerator ECU"
  /begin MODULE SIM_FRIDGE_MODULE
    /begin MEASUREMENT BOX_TEMP_C
      "Synthetic refrigerator box temperature"
      FLOAT32 NO_RESCALE -40 85
      READ_ONLY 0 0
      UNIT "degC"
    /end MEASUREMENT
    /begin MEASUREMENT EVAPORATOR_TEMP_C
      "Synthetic evaporator temperature"
      FLOAT32 NO_RESCALE -40 85
      READ_ONLY 0 0
      UNIT "degC"
    /end MEASUREMENT
    /begin MEASUREMENT AMBIENT_TEMP_C
      "Synthetic ambient temperature"
      FLOAT32 NO_RESCALE -40 85
      READ_ONLY 0 0
      UNIT "degC"
    /end MEASUREMENT
    /begin MEASUREMENT SUPPLY_VOLTAGE_V
      "Synthetic ECU supply voltage"
      FLOAT32 NO_RESCALE 0 24
      READ_ONLY 0 0
      UNIT "V"
    /end MEASUREMENT
    /begin MEASUREMENT COMPRESSOR_CURRENT_A
      "Synthetic compressor current"
      FLOAT32 NO_RESCALE 0 30
      READ_ONLY 0 0
      UNIT "A"
    /end MEASUREMENT
    /begin MEASUREMENT COMPRESSOR_STATE
      "Synthetic compressor state"
      UBYTE NO_RESCALE 0 1
      READ_ONLY 0 0
      UNIT "bool"
    /end MEASUREMENT
    /begin MEASUREMENT HUMIDITY_PERCENT
      "Synthetic chamber humidity"
      FLOAT32 NO_RESCALE 0 100
      READ_ONLY 0 100
      UNIT "percent"
    /end MEASUREMENT
    /begin MEASUREMENT CONDENSATION_FLAG
      "Synthetic condensation indication"
      UBYTE NO_RESCALE 0 1
      READ_ONLY 0 1
      UNIT "bool"
    /end MEASUREMENT
    /begin MEASUREMENT CAN_ERROR_COUNT
      "Synthetic CAN error count"
      ULONG NO_RESCALE 0 1000
      READ_ONLY 0 0
      UNIT "count"
    /end MEASUREMENT
    /begin MEASUREMENT DOOR_SWITCH
      "Synthetic refrigerator door switch"
      UBYTE NO_RESCALE 0 1
      READ_ONLY 0 1
      UNIT "bool"
    /end MEASUREMENT
    /begin MEASUREMENT FAN_SPEED_RPM
      "Synthetic condenser fan speed"
      ULONG NO_RESCALE 0 5000
      READ_ONLY 0 0
      UNIT "rpm"
    /end MEASUREMENT
    /begin MEASUREMENT RUN_TIME_S
      "Synthetic compressor run time"
      ULONG NO_RESCALE 0 100000
      READ_ONLY 0 0
      UNIT "s"
    /end MEASUREMENT
    /begin MEASUREMENT AUX_SIGNAL_01
      "Synthetic auxiliary refrigerator signal 01"
